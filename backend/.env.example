# ============================================================
#  Cypher Backend — .env.example
#  Copia este archivo como .env y rellena tus valores reales.
#  NUNCA subas el .env real a git.
# ============================================================

# ── RPC de Solana ─────────────────────────────────────────
# Devnet (gratis, para desarrollo):
SOLANA_RPC_URL=https://api.devnet.solana.com

# Mainnet (usa un proveedor con rate limit alto):
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=TU_API_KEY
# SOLANA_RPC_URL=https://rpc.ankr.com/solana/TU_API_KEY

# ── Smart Contract ────────────────────────────────────────
# Program ID generado tras ejecutar: anchor build && anchor deploy
TRUST_REGISTRY_PROGRAM_ID=CyphXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Keypair del Inspector (wallet del backend) ────────────
# Ruta al archivo JSON del keypair que firma las transacciones.
# Generar uno nuevo con: solana-keygen new -o inspector-keypair.json
# NUNCA uses el keypair principal de tu wallet personal.
INSPECTOR_KEYPAIR_PATH=./inspector-keypair.json

# ── IA (opcional — integración con LLM) ──────────────────
# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GOOGLE_API_KEY=AIza...
